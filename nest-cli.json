{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/playground",
  "sourceRoot": "apps/playground/src",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/playground/tsconfig.app.json"
  },
  "projects": {
    "playground": {
      "type": "application",
      "root": "apps/playground",
      "entryFile": "main",
      "sourceRoot": "apps/playground/src",
      "compilerOptions": {
        "tsConfigPath": "apps/playground/tsconfig.app.json"
      }
    },
    "dynamic-module": {
      "type": "application",
      "root": "apps/dynamic-module",
      "entryFile": "main",
      "sourceRoot": "apps/dynamic-module/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dynamic-module/tsconfig.app.json"
      }
    }
  }
}
