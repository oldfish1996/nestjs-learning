{
  "name": "nestjs-learning",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS learning project organized by weekly learning goals.",
  "scripts": {
    "build": "nest build playground",
    "build:playground": "nest build playground",
    "build:dynamic": "nest build dynamic-module",
    "start": "nest start playground",
    "start:dev": "nest start playground --watch",
    "start:playground": "nest start playground --watch",
    "start:dynamic": "nest start dynamic-module --watch",
    "start:prod": "node dist/apps/playground/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./apps/nestjs-learning/test/jest-e2e.json",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-fastify": "^11.2.3",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express-session": "^1.19.0",
    "fastify": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "libs/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
